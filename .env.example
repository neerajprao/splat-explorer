# Copied to .env by scripts/setup_mac.sh. Every line is optional.

# Where uploads, frames, COLMAP data and finished scenes are stored.
# SPLAT_DATA_DIR=./data

# Tool locations (normally found automatically).
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
# COLMAP_BIN=/opt/homebrew/bin/colmap
BRUSH_BIN=

# Default training quality: preview | standard | high
SPLAT_DEFAULT_QUALITY=standard

# Frame extraction: frames kept per second of video, the cap, and how many
# candidates are compared to pick the sharpest one.
# SPLAT_TARGET_FPS=2
# SPLAT_MAX_FRAMES=300
# SPLAT_SHARP_GROUP=3
# SPLAT_FRAME_LONG_SIDE_PX=1920

# Upload limits
# SPLAT_MAX_UPLOAD_MB=4096
# SPLAT_MIN_DURATION_S=10
# SPLAT_MAX_DURATION_S=600
# SPLAT_MIN_SHORT_SIDE_PX=720

# COLMAP: fail below this share of frames placed, warn below the second.
# SPLAT_MIN_REGISTERED_RATIO=0.3
# SPLAT_WARN_REGISTERED_RATIO=0.7
# SPLAT_USE_GLOBAL_MAPPER=1

# Keep frames_raw / COLMAP database / Brush checkpoints for debugging.
# SPLAT_KEEP_INTERMEDIATES=0
